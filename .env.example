# Comma-separated production domains. The default also permits *.vercel.app.
APP_ALLOWED_HOSTS=example.com,www.example.com

# 0 disables the application-level body limit for a backend running locally.
# Vercel still applies its own platform request limit independently.
APP_MAX_REQUEST_BYTES=0
APP_MAX_CONCURRENT_PLANS=2
APP_PLAN_REQUESTS_PER_MINUTE=10

# Leave disabled in production. Set to true only for local API exploration.
APP_ENABLE_DOCS=false
# Narzędzie administratorskie jest domyślnie aktywne wyłącznie poza Vercel.
# APP_ALLOW_LOCAL_ADMIN=true

# Opcjonalny katalog dużych, publicznych zestawów w Vercel Blob. Manifest i
# każdy plik sieci są weryfikowane SHA-256 przed użyciem.
# APP_PUBLIC_NETWORK_MANIFEST_URL=https://example.public.blob.vercel-storage.com/public-networks.json
# APP_PUBLIC_NETWORK_MANIFEST_SHA256=64_znaki_szestnastkowe
APP_PUBLIC_DATA_HOSTS=.public.blob.vercel-storage.com
APP_MAX_PUBLIC_NETWORK_BYTES=200000000
